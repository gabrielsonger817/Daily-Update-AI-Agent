# ── Anthropic Claude API ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Twilio (SMS delivery + received SMS) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX   # Your Twilio phone number
MY_PHONE_NUMBER=+1XXXXXXXXXX      # Your personal phone number

# ── News API (https://newsapi.org) ────────────────────────────────────────────
NEWS_API_KEY=your_newsapi_key_here

# ── OpenWeatherMap (https://openweathermap.org/api) ───────────────────────────
OPENWEATHER_API_KEY=your_openweathermap_key_here
MY_CITY=New York
MY_COUNTRY_CODE=US

# ── Stock Watchlist (comma-separated ticker symbols) ──────────────────────────
STOCK_WATCHLIST=SPY,QQQ,AAPL,GOOGL,MSFT

# ── Gmail / Email (use an App Password, NOT your real password) ───────────────
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_IMAP_SERVER=imap.gmail.com

# ── Teamworks ─────────────────────────────────────────────────────────────────
# Contact Teamworks support for API credentials
TEAMWORKS_API_KEY=your_teamworks_api_key
TEAMWORKS_ORG_ID=your_teamworks_org_id

# ── Schedule ─────────────────────────────────────────────────────────────────
UPDATE_HOUR=8
UPDATE_MINUTE=45
TIMEZONE=America/New_York

# ── Overnight window (how many hours back to look for messages) ───────────────
OVERNIGHT_HOURS=12
